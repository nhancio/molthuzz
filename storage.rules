rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profiles/{uid}/{file} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.size <= 8 * 1024 * 1024 && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
