# Public Expo configuration. Public Firebase keys identify the app; rules protect data.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_API_URL=https://makein-nhancio.netlify.app
# Keep disabled until merchant selection, test-mode verification and live approval are complete.
EXPO_PUBLIC_PAYMENTS_ENABLED=false

# SERVER ONLY: Netlify Functions runtime; never EXPO_PUBLIC_ or committed values.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=
PAYMENT_ALLOWED_ORIGINS=https://makein-nhancio.netlify.app
